  m_Name: QuestionBank_es
  m_EditorClassIdentifier: Trivias.Questions::Trivias.Questions.Data.QuestionBank
  _language: es
  _questions:
  - _id: geo-001
    _category: "Geograf\xEDa"
    _difficulty: 1
    _text: "\xBFCu\xE1l es la capital de Francia?"
    _options:
    - "Par\xEDs"
    - Lyon
    - Marsella
    - Niza
    _correctOption: 0
    _explanation: "Par\xEDs es la capital de Francia y su ciudad m\xE1s poblada."
    _source: "https://es.wikipedia.org/wiki/Par\xEDs"
  - _id: cie-001
    _category: Ciencia
    _difficulty: 1
    _text: "\xBFQu\xE9 planeta es conocido como el planeta rojo?"
    _options:
    - Venus
    - Marte
    - "J\xFApiter"
    - Mercurio
    _correctOption: 1
    _explanation: "El \xF3xido de hierro de su superficie le da a Marte su color rojizo."
    _source: https://es.wikipedia.org/wiki/Marte_(planeta)
  - _id: nat-001
    _category: Naturaleza
    _difficulty: 1
    _text: "\xBFCu\xE1ntas patas tiene una ara\xF1a?"
    _options:
    - Seis
    - Diez
    - Ocho
    - Doce
    _correctOption: 2
    _explanation: "Las ara\xF1as son ar\xE1cnidos: tienen ocho patas, a diferencia de los insectos, que tienen seis."
    _source: https://es.wikipedia.org/wiki/Araneae
  - _id: geo-002
    _category: "Geograf\xEDa"
    _difficulty: 1
    _text: "\xBFCu\xE1l es el oc\xE9ano m\xE1s grande del mundo?"
    _options:
    - "Atl\xE1ntico"
    - "\xCDndico"
    - "\xC1rtico"
    - "Pac\xEDfico"
    _correctOption: 3
    _explanation: "El Pac\xEDfico cubre cerca de un tercio de la superficie de la Tierra."
    _source: "https://es.wikipedia.org/wiki/Oc\xE9ano_Pac\xEDfico"
  - _id: art-001
    _category: Arte
    _difficulty: 1
    _text: "\xBFQui\xE9n pint\xF3 la Mona Lisa?"
    _options:
    - Leonardo da Vinci
    - "Miguel \xC1ngel"
    - Rafael
    - Botticelli
    _correctOption: 0
    _explanation: "Leonardo da Vinci la pint\xF3 a principios del siglo XVI; hoy est\xE1 en el Museo del Louvre."
    _source: https://es.wikipedia.org/wiki/La_Gioconda
  - _id: dep-001
    _category: Deportes
    _difficulty: 1
    _text: "\xBFCu\xE1ntos jugadores de cada equipo hay en el campo en un partido de f\xFAtbol?"
    _options:
    - Diez
    - Once
    - Nueve
    - Doce
    _correctOption: 1
    _explanation: Cada equipo alinea once jugadores, incluido el portero.
    _source: "https://es.wikipedia.org/wiki/Reglas_del_f\xFAtbol"
  - _id: his-001
    _category: Historia
    _difficulty: 2
    _text: "\xBFEn qu\xE9 a\xF1o pis\xF3 el ser humano la Luna por primera vez?"
    _options:
    - 1965
    - 1972
    - 1969
    - 1959
    _correctOption: 2
    _explanation: Neil Armstrong y Buzz Aldrin llegaron a la Luna con el Apolo 11 en julio de 1969.
    _source: https://es.wikipedia.org/wiki/Apolo_11
  - _id: cie-002
    _category: Ciencia
    _difficulty: 2
    _text: "\xBFCu\xE1l es el s\xEDmbolo qu\xEDmico del oro?"
    _options:
    - Ag
    - Or
    - Go
    - Au
    _correctOption: 3
    _explanation: "Au viene del lat\xEDn aurum. Ag es la plata."
    _source: https://es.wikipedia.org/wiki/Oro
  - _id: mus-001
    _category: "M\xFAsica"
    _difficulty: 2
    _text: "\xBFQu\xE9 compositor escribi\xF3 \xABLas cuatro estaciones\xBB?"
    _options:
    - Antonio Vivaldi
    - Johann Sebastian Bach
    - Wolfgang Amadeus Mozart
    - "Georg Friedrich H\xE4ndel"
    _correctOption: 0
    _explanation: "Vivaldi public\xF3 estos cuatro conciertos para viol\xEDn en 1725."
    _source: https://es.wikipedia.org/wiki/Las_cuatro_estaciones
  - _id: cie-003
    _category: Ciencia
    _difficulty: 2
    _text: "\xBFCu\xE1l es el hueso m\xE1s largo del cuerpo humano?"
    _options:
    - Tibia
    - "F\xE9mur"
    - "H\xFAmero"
    - "Peron\xE9"
    _correctOption: 1
    _explanation: "El f\xE9mur, el hueso del muslo, es el m\xE1s largo y resistente del cuerpo."
    _source: "https://es.wikipedia.org/wiki/F\xE9mur"
  - _id: lit-001
    _category: Literatura
    _difficulty: 2
    _text: "\xBFQui\xE9n escribi\xF3 \xABCien a\xF1os de soledad\xBB?"
    _options:
    - Mario Vargas Llosa
    - "Julio Cort\xE1zar"
    - "Gabriel Garc\xEDa M\xE1rquez"
    - Pablo Neruda
    _correctOption: 2
    _explanation: "Gabriel Garc\xEDa M\xE1rquez la public\xF3 en 1967; recibi\xF3 el Nobel de Literatura en 1982."
    _source: "https://es.wikipedia.org/wiki/Cien_a\xF1os_de_soledad"
  - _id: cie-004
    _category: Ciencia
    _difficulty: 2
    _text: "\xBFCu\xE1l es el gas m\xE1s abundante en la atm\xF3sfera terrestre?"
    _options:
    - "Ox\xEDgeno"
    - "Di\xF3xido de carbono"
    - "Arg\xF3n"
    - "Nitr\xF3geno"
    _correctOption: 3
    _explanation: "El nitr\xF3geno es alrededor del 78 % del aire; el ox\xEDgeno, cerca del 21 %."
    _source: "https://es.wikipedia.org/wiki/Atm\xF3sfera_terrestre"
  - _id: geo-003
    _category: "Geograf\xEDa"
    _difficulty: 3
    _text: "\xBFCu\xE1l es el r\xEDo m\xE1s largo de Europa?"
    _options:
    - Volga
    - Danubio
    - Rin
    - Loira
    _correctOption: 0
    _explanation: El Volga, en Rusia, mide unos 3.500 km y desemboca en el mar Caspio.
    _source: https://es.wikipedia.org/wiki/Volga
  - _id: cie-005
    _category: Ciencia
    _difficulty: 3
    _text: "\xBFCu\xE1l es el elemento qu\xEDmico m\xE1s abundante en la corteza terrestre?"
    _options:
    - Silicio
    - "Ox\xEDgeno"
    - Aluminio
    - Hierro
    _correctOption: 1
    _explanation: "El ox\xEDgeno supone casi la mitad de la masa de la corteza, sobre todo en forma de silicatos y \xF3xidos."
    _source: "https://es.wikipedia.org/wiki/Abundancia_de_los_elementos_qu\xEDmicos"
  - _id: geo-004
    _category: "Geograf\xEDa"
    _difficulty: 3
    _text: "\xBFQu\xE9 pa\xEDs tiene m\xE1s husos horarios, contando sus territorios de ultramar?"
    _options:
    - Rusia
    - Estados Unidos
    - Francia
    - Reino Unido
    _correctOption: 2
    _explanation: Gracias a sus territorios de ultramar, Francia abarca 12 husos horarios.
    _source: https://es.wikipedia.org/wiki/Huso_horario
  - _id: geo-005
    _category: "Geograf\xEDa"
    _difficulty: 3
    _text: "\xBFCu\xE1l es la capital de Australia?"
    _options:
    - "S\xEDdney"
    - Melbourne
    - Perth
    - Canberra
    _correctOption: 3
    _explanation: "Canberra se construy\xF3 como capital en el siglo XX, como acuerdo entre S\xEDdney y Melbourne."
    _source: https://es.wikipedia.org/wiki/Canberra
  - _id: cie-006
    _category: Ciencia
    _difficulty: 3
    _text: "\xBFCu\xE1ntos huesos tiene el cuerpo humano adulto?"
    _options:
    - 206
    - 212
    - 198
    - 220
    _correctOption: 0
    _explanation: "Un adulto tiene 206 huesos; al nacer hay m\xE1s, porque varios se fusionan con el crecimiento."
    _source: https://es.wikipedia.org/wiki/Esqueleto_humano
  - _id: his-002
    _category: Historia
    _difficulty: 3
    _text: "\xBFEn qu\xE9 a\xF1o cay\xF3 el Muro de Berl\xEDn?"
    _options:
    - 1987
    - 1989
    - 1991
    - 1985
    _correctOption: 1
    _explanation: "El muro cay\xF3 el 9 de noviembre de 1989; la reunificaci\xF3n alemana lleg\xF3 en 1990."
    _source: "https://es.wikipedia.org/wiki/Ca\xEDda_del_Muro_de_Berl\xEDn"
  - _id: nat-002
    _category: Naturaleza
    _difficulty: 1
    _text: "\xBFCu\xE1l es el animal terrestre m\xE1s grande del mundo?"
    _options:
    - Rinoceronte blanco
    - Elefante africano
    - "Hipop\xF3tamo"
    - Jirafa
    _correctOption: 1
    _explanation: El elefante africano de sabana puede superar las seis toneladas.
    _source: https://es.wikipedia.org/wiki/Loxodonta_africana
  - _id: cur-001
    _category: Curiosidades
    _difficulty: 1
    _text: "\xBFCu\xE1ntos d\xEDas tiene un a\xF1o bisiesto?"
    _options:
    - 365
    - 364
    - 366
    - 360
    _correctOption: 2
    _explanation: "El a\xF1o bisiesto a\xF1ade el 29 de febrero, as\xED que tiene 366 d\xEDas."
    _source: "https://es.wikipedia.org/wiki/A\xF1o_bisiesto"
  - _id: geo-006
    _category: "Geograf\xEDa"
    _difficulty: 1
    _text: "\xBFEn qu\xE9 continente est\xE1 la mayor parte de Egipto?"
    _options:
    - Asia
    - Europa
    - "Ocean\xEDa"
    - "\xC1frica"
    _correctOption: 3
    _explanation: "Egipto est\xE1 en el noreste de \xC1frica; solo la pen\xEDnsula del Sina\xED est\xE1 en Asia."
    _source: https://es.wikipedia.org/wiki/Egipto
  - _id: mus-002
    _category: "M\xFAsica"
    _difficulty: 1
    _text: "\xBFQu\xE9 instrumento tiene teclas blancas y negras?"
    _options:
    - Piano
    - "Viol\xEDn"
    - Trompeta
    - Arpa
    _correctOption: 0
    _explanation: "El piano tiene 52 teclas blancas y 36 negras en su versi\xF3n est\xE1ndar de 88 teclas."
    _source: https://es.wikipedia.org/wiki/Piano
  - _id: cie-007
    _category: Ciencia
    _difficulty: 2
    _text: "\xBFCu\xE1l es el planeta m\xE1s grande del sistema solar?"
    _options:
    - Saturno
    - "J\xFApiter"
    - Neptuno
    - Urano
    _correctOption: 1
    _explanation: "J\xFApiter tiene m\xE1s del doble de masa que todos los dem\xE1s planetas juntos."
    _source: "https://es.wikipedia.org/wiki/J\xFApiter_(planeta)"
  - _id: geo-007
    _category: "Geograf\xEDa"
    _difficulty: 2
    _text: "\xBFEn qu\xE9 pa\xEDs se encuentra Machu Picchu?"
    _options:
    - Bolivia
    - Chile
    - "Per\xFA"
    - Ecuador
    _correctOption: 2
    _explanation: "Machu Picchu es una ciudadela inca en los Andes de Per\xFA, cerca de Cuzco."
    _source: https://es.wikipedia.org/wiki/Machu_Picchu
  - _id: cie-008
    _category: Ciencia
    _difficulty: 2
    _text: "\xBFQui\xE9n formul\xF3 la teor\xEDa de la relatividad?"
    _options:
    - Isaac Newton
    - Galileo Galilei
    - Niels Bohr
    - Albert Einstein
    _correctOption: 3
    _explanation: "Einstein public\xF3 la relatividad especial en 1905 y la general en 1915."
    _source: "https://es.wikipedia.org/wiki/Teor\xEDa_de_la_relatividad"
  - _id: cur-002
    _category: Curiosidades
    _difficulty: 2
    _text: "\xBFCu\xE1l es la moneda oficial de Jap\xF3n?"
    _options:
    - Yen
    - Won
    - Yuan
    - Rupia
    _correctOption: 0
    _explanation: "El yen es la moneda de Jap\xF3n; el won es de Corea y el yuan, de China."
    _source: https://es.wikipedia.org/wiki/Yen
  - _id: geo-008
    _category: "Geograf\xEDa"
    _difficulty: 3
    _text: "\xBFCu\xE1l es el pa\xEDs m\xE1s peque\xF1o del mundo por superficie?"
    _options:
    - "M\xF3naco"
    - Ciudad del Vaticano
    - San Marino
    - Liechtenstein
    _correctOption: 1
    _explanation: "La Ciudad del Vaticano mide unas 44 hect\xE1reas, dentro de Roma."
    _source: https://es.wikipedia.org/wiki/Ciudad_del_Vaticano
  - _id: his-003
    _category: Historia
    _difficulty: 3
    _text: "\xBFEn qu\xE9 a\xF1o comenz\xF3 la Revoluci\xF3n francesa?"
    _options:
    - 1776
    - 1799
    - 1789
    - 1815
    _correctOption: 2
    _explanation: Suele situarse su inicio en 1789, con la toma de la Bastilla el 14 de julio.
    _source: "https://es.wikipedia.org/wiki/Revoluci\xF3n_francesa"
  - _id: cie-009
    _category: Ciencia
    _difficulty: 3
    _text: "\xBFQui\xE9n fue la primera persona en ganar dos premios Nobel?"
    _options:
    - Rosalind Franklin
    - Lise Meitner
    - Ada Lovelace
    - Marie Curie
    _correctOption: 3
    _explanation: "Marie Curie gan\xF3 el Nobel de F\xEDsica en 1903 y el de Qu\xEDmica en 1911."
    _source: https://es.wikipedia.org/wiki/Marie_Curie
  - _id: geo-009
    _category: "Geograf\xEDa"
    _difficulty: 3
    _text: "\xBFCu\xE1l es la monta\xF1a m\xE1s alta de \xC1frica?"
    _options:
    - Kilimanjaro
    - Monte Kenia
    - Monte Stanley
    - Toubkal
    _correctOption: 0
    _explanation: El Kilimanjaro, en Tanzania, alcanza unos 5.895 metros.
    _source: https://es.wikipedia.org/wiki/Kilimanjaro
