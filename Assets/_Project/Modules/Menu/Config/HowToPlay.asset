%YAML 1.1
%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d1280f94fd4e48c495272771f77f548, type: 3}
  m_Name: HowToPlay
  m_EditorClassIdentifier: Trivias.Menu::Trivias.Menu.Data.HowToPlayContent
  _pages:
  - _step: Objetivo
    _title: El objetivo
    _body: 'De <b>2 a 6</b> jugadores contra <b>15 preguntas</b>.

      Cada cabina es una respuesta.

      Llevad el dinero a la <b>cabina correcta</b> y llegad al final con dinero.'
  - _step: Dinero
    _title: El dinero
    _body: '[E] coge o deja uno. [Q] varios. [R] devuelve todo a la mesa.

      Cambia 10 fajos por 1 bolsa y 10 bolsas por 1 lingote.

      El dinero fuera de las bandejas <b>se pierde</b> al verificar.'
  - _step: Verificar
    _title: Verificar
    _body: "Pulsa <b>VERIFICAR</b> con [E]: las apuestas se bloquean al instante.\nTras <b>3 segundos</b> se revela la respuesta.\nSi se acaba el reloj, se verifica autom\xE1ticamente."
  - _step: "Comod\xEDn"
    _title: "Apu\xE9state a ti mismo"
    _body: "Entra en la plataforma y pulsa [E] para apostar tu comod\xEDn.\nSi aciertas, <b>multiplicas</b> el dinero de esa cabina.\nSi fallas, quedas <b>expulsado</b> hasta la siguiente partida. Antes del cierre, [E] cancela."
  - _step: Fichas
    _title: Fichas y tienda
    _body: 'Las preguntas superadas dan <b>fichas</b> a cada jugador.

      Se guardan para comprar personajes y accesorios en la <b>tienda</b> de la sala de espera.

      Solo cambian la apariencia: no dan ventajas.'
  - _step: Controles
    _title: Controles
    _body: "[W] [A] [S] [D] moverte \xB7 [Shift] correr\n[Rat\xF3n] mirar \xB7 [Espacio] saltar\n[E] acci\xF3n \xB7 [Q] varios \xB7 [R] devolver a la mesa\n[Esc] men\xFA; la partida contin\xFAa para los dem\xE1s."
