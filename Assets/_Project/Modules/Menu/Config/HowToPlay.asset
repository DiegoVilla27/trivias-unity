%TAG !u! tag:unity3d.com,2011:
--- !u!114 &11400000
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 0d1280f94fd4e48c495272771f77f548, type: 3}
  m_Name: HowToPlay
  m_EditorClassIdentifier: Trivias.Menu::Trivias.Menu.Data.HowToPlayContent
  _pages:
  - _title: El objetivo
    _body: "Equipo de <b>2 a 6</b> contra <b>15 preguntas</b>.\n\nCada cabina (<b>A, B, C, D</b>) es una respuesta. Pon el dinero en la <b>cabina correcta</b>: el resto se pierde.\n\nLlegad al final con dinero y gan\xE1is."
  - _title: El dinero
    _body: "Coge dinero de la <b>mesa</b> y d\xE9jalo en la <b>bandeja</b> de una cabina.\n\n<b>E</b> uno \xB7 <b>Q</b> varios \xB7 <b>R</b> devolver a la mesa\n<b>Cambio</b>: 10 fajos = 1 bolsa \xB7 10 bolsas = 1 lingote\n\n<color=#FF8080>Lo que no est\xE9 en una bandeja se pierde.</color>"
  - _title: Verificar
    _body: "\xBFListos? Pulsad <b>VERIFICAR</b> con <b>E</b>.\n\n<b>3 segundos</b> y se revela: solo queda el dinero de la cabina correcta.\n\nSi se acaba el reloj, se verifica sola."
  - _title: "Apu\xE9state a ti mismo"
    _body: "Sube a la <b>plataforma</b> de una cabina y pulsa <b>E</b>.\n\n<b>Aciertas</b>: el dinero se multiplica (<b>x2</b>, <b>x3</b>\u2026)\n<b>Fallas</b>: el tubo te succiona y quedas <b>expulsado</b>\n\n<b>E</b> otra vez para bajarte \xB7 todos apostados: <b>Q</b> verifica"
  - _title: Fichas y tienda
    _body: "Cada partida te da <b>fichas</b>: cuantas m\xE1s preguntas super\xE9is, m\xE1s.\n\nG\xE1stalas en la <b>tienda</b> de la sala de espera.\nSolo es ropa: <b>no da ventajas</b>."
  - _title: Controles
    _body: "<b>WASD</b> moverse \xB7 <b>Shift</b> correr\n<b>Rat\xF3n</b> mirar \xB7 <b>Espacio</b> saltar\n<b>E</b> acci\xF3n \xB7 <b>Q</b> varios \xB7 <b>R</b> devolver\n<b>Esc</b> men\xFA"
